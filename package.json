{
    "name": "telegram-video-downloader-bot",
    "version": "1.0.0",
    "description": "Telegram bot for downloading Instagram, TikTok, and YouTube Shorts videos using Node.js, tsx, grammY, and PostgreSQL",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "tsx src/index.ts",
        "dev": "tsx watch src/index.ts",
        "test": "tsx --test tests/**/*.test.ts"
    },
    "dependencies": {
        "@grammyjs/auto-retry": "^2.0.2",
        "dotenv": "^16.4.7",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "grammy": "^1.35.0",
        "postgres": "^3.4.5"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "tsx": "^4.23.7"
    }
}